{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=smart_stylist;Username=stylist;Password=stylist"
  },
  "Hangfire": {
    "WorkerCount": 2
  },
  "Newsletters": {
    "Cron": "20 * * * *",
    "LookbackDays": 14,
    "Model": "claude-haiku-5-5",
    "Imap": {
      "Host": "",
      "Port": 993,
      "UseSsl": true,
      "Username": "",
      "Folder": "[Gmail]/All Mail"
    }
  },
  "Picks": {
    "Cron": "30 6 * * *",
    "Telegram": {
      "BotToken": "",
      "BotName": ""
    }
  },
  "Awin": {
    "ApiKey": "",
    "FeedIds": [],
    "Cron": "0 6 * * *",
    "MaxProductsPerFeed": 5000
  },
  "Catalog": {
    "DailyCron": "0 5 * * *",
    "MaxProductsPerShop": 300,
    "RequestDelayMs": 1500,
    "Browser": {
      "Headless": false,
      "ExecutablePath": "",
      "Channel": "chrome",
      "UserDataDir": "~/.smart-stylist-chrome",
      "PageSettleMs": 1500
    },
    "BrowserWatch": {
      "Cron": "0 7,13,19 * * *",
      "MinHoursBetweenVisits": 4,
      "MaxPagesPerShop": 15
    },
    "Egresses": {
      "us": { "ProxyUrl": "", "MinIntervalMs": 5000 }
    },
    "GeoRetryEgress": "us",
    "PriceSanity": {
      "MinShareOfUsual": 0.15,
      "FloorCurrency": "USD",
      "DefaultFloor": 3,
      "Floors": [
        {"Category": "socks and underwear", "Keywords": ["sock", "socks", "boxer", "boxers", "brief", "briefs", "underwear"], "Min": 2},
        {"Category": "tees", "Keywords": ["tee", "tees", "t-shirt", "tshirt", "tank"], "Min": 5},
        {"Category": "outerwear", "Keywords": ["jacket", "coat", "parka", "puffer", "anorak", "overshirt"], "Min": 20},
        {"Category": "footwear", "Keywords": ["shoe", "shoes", "sneaker", "sneakers", "boot", "boots", "loafer", "loafers", "trainer", "trainers"], "Min": 15},
        {"Category": "knitwear and sweatshirts", "Keywords": ["sweater", "sweatshirt", "hoodie", "crewneck", "cardigan", "fleece", "merino", "cashmere", "knit"], "Min": 12},
        {"Category": "trousers and jeans", "Keywords": ["jean", "jeans", "chino", "chinos", "pant", "pants", "trouser", "trousers", "jogger", "joggers", "sweatpants"], "Min": 10},
        {"Category": "shirts", "Keywords": ["shirt", "polo", "henley", "oxford"], "Min": 8},
        {"Category": "shorts", "Keywords": ["short", "shorts"], "Min": 6}
      ]
    },
    "ArchiveDelayMs": 4000,
    "ArchiveLookbackDays": 365,
    "CoreProducts": [
      {"Shop": "levis", "Title": "Levi's 541 Athletic Taper Men's Jeans", "Url": "https://www.levi.com/US/en_US/clothing/men/jeans/taper/541-athletic-taper-fit-mens-jeans/p/181810692", "ArchiveUrls": ["https://www.levi.com/US/en_US/clothing/men/jeans/taper/541TM-athletic-taper-fit-mens-jeans/p/181810692"]},

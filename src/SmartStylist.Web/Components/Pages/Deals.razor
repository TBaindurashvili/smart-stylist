@page "/deals"
@rendermode InteractiveServer
@inject DealsReport Report

<PageTitle>Deals · Smart Stylist</PageTitle>

<h1>Buy now or wait?</h1>
<p class="lead">
    Prices from the last @DealsReport.RecentDays days that are on sale or below their usual price, from sale emails,
    the browser extension, Awin product feeds and the daily collector. Each is judged by the product's own price history,
    not by the percentage the shop advertises. A verdict needs @DealsReport.MinHistoryDays days of history.
</p>

@if (_rows is null)
{
    <p>Loading…</p>
}
else if (_rows.Count == 0)
{
    <p>No deals yet. Save a product page with the browser extension, or run <code>newsletters</code> in the worker.</p>
}
else
{
    <div class="summary">
        @foreach (var verdict in new[] { DealVerdict.BuyNow, DealVerdict.Wait, DealVerdict.StillLearning, DealVerdict.FakeSale })
        {
            <button class="pill verdict-@Css(verdict) @(_filter == verdict ? "selected" : "")" @onclick="() => Toggle(verdict)">
                @Label(verdict): @_rows.Count(r => r.Assessment.Verdict == verdict)
            </button>
        }
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Product</th><th>Verdict</th><th class="num">Price</th><th class="num">Shop says</th>
                    <th class="num">Usual</th><th class="num">Real discount</th><th class="num">Days</th><th>Seen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows.Where(r => _filter is null || r.Assessment.Verdict == _filter))
                {
                    var a = row.Assessment;
                    <tr>
                        <td>
                            <a href="@row.Url" target="_blank" rel="noopener">@row.Title</a>
                            <div class="muted">@row.ShopName@(row.Brand is null ? "" : $" · {row.Brand}")</div>
                        </td>
                        <td>
                            <span class="pill verdict-@Css(a.Verdict)">@Label(a.Verdict)</span>
                            <div class="reason">@a.Reason</div>
                        </td>
                        <td class="num">@Money(row.Price, row.Currency)</td>
                        <td class="num">
                            @if (a.ClaimedDiscount is { } claimed)
                            {
                                <span>@claimed.ToString("P0") off</span>
                                <div class="muted"><s>@Money(row.ListPrice!.Value, row.Currency)</s></div>
                            }
                        </td>
                        <td class="num">@(a.UsualPrice is null ? "–" : Money(a.UsualPrice.Value, row.Currency))</td>
                        <td class="num">@(a.RealDiscount is null ? "–" : a.RealDiscount.Value.ToString("P0"))</td>
                        <td class="num">@a.Days</td>
                        <td>@row.ObservedOn.ToString("MMM d")<div class="muted">@Source(row.Source)</div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="muted">
        <strong>Buy now</strong>: never been cheaper, or a rare sale on an item that is usually full price.
        <strong>Wait</strong>: below its usual price, but it has been cheaper, so that price is likely to come back.
        <strong>Fake sale</strong>: the shop shows a crossed-out price, but this is about what it usually costs.
        <strong>Still learning</strong>: fewer than @DealsReport.MinHistoryDays earlier days of prices, so only the shop's claim is shown.
    </p>
}

@code {
    private IReadOnlyList<DealRow>? _rows;
    private DealVerdict? _filter;

    protected override async Task OnInitializedAsync() => _rows = await Report.BuildAsync(CancellationToken.None);

    private void Toggle(DealVerdict verdict) => _filter = _filter == verdict ? null : verdict;

    private static string Label(DealVerdict verdict) => verdict switch
    {
        DealVerdict.BuyNow => "Buy now",
        DealVerdict.Wait => "Wait",
        DealVerdict.StillLearning => "Still learning",
        DealVerdict.FakeSale => "Fake sale",
        _ => "Usual price",
    };

    private static string Css(DealVerdict verdict) => verdict.ToString().ToLowerInvariant();

    private static string Source(PriceSource source) => source switch
    {
        PriceSource.Newsletter => "sale email",
        PriceSource.Extension => "saved in browser",
        PriceSource.AffiliateFeed => "Awin feed",
        _ => "collector",
    };

    private static string Money(decimal amount, string currency) => $"{amount:0.00} {currency}";
}
